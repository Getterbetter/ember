<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- __PREFIX__ is replaced with EMBER_BUNDLE_PREFIX by the "Embed privileged helper" build phase. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>__PREFIX__.ember.helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/EmberHelper</string>
	<key>MachServices</key>
	<dict>
		<key>__PREFIX__.ember.helper</key>
		<true/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>__PREFIX__.ember</string>
	</array>
</dict>
</plist>
